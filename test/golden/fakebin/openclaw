#!/usr/bin/env node
// Fake openclaw CLI: records argv, emits a result envelope like the real one (port of the Python fake).
const fs = require('fs');
const argv = process.argv.slice(2);
fs.appendFileSync(process.env.FAKE_OPENCLAW_RECORD, JSON.stringify(argv) + '\n');
const msg = argv[argv.indexOf('--message') + 1];
if (msg.includes('FAIL')) { process.stderr.write('boom\n'); process.exit(3); }
const finish = () => {
  process.stderr.write('[log] noise line\n{not json\n');
  process.stderr.write(JSON.stringify({ payloads: [{ text: 'echo: ' + msg }], meta: {} }) + '\n');
};
if (msg.includes('SLOW')) setTimeout(finish, 2000); else finish();
